{
  "about": "Which calendar events a true-island Home Assistant station cannot run without the cloud copy. The app (cloud_dependency.dart eventNeedsCloud, from the config alone) and the integration (event_evaluator.needs_cloud) must agree on every vector. Canonical copy: svitgrid apps/mobile/test/fixtures/needs_cloud_vectors.json. Vendored, byte for byte, in home-assistant-svitgrid tests/fixtures/needs_cloud_vectors.json. Change both in the same change.",
  "vectors": [
    {"name": "day planning", "needsCloud": true,
     "event": {"mode": "day_planning", "config": {}}},
    {"name": "generator start that waits for a scheduled outage", "needsCloud": true,
     "event": {"mode": "gen_force", "config": {"requireScheduledOutage": true}}},
    {"name": "generator start on grid down only", "needsCloud": false,
     "event": {"mode": "gen_force", "config": {"requireGridDown": true, "requireScheduledOutage": false}}},
    {"name": "custom: forecast today", "needsCloud": true,
     "event": {"mode": "custom", "config": {"customConditions": [{"type": "forecast_today", "op": "gte", "thresholdKwh": 20}], "customActions": [{"type": "work_mode", "value": 0}]}}},
    {"name": "custom: forecast tomorrow", "needsCloud": true,
     "event": {"mode": "custom", "config": {"customConditions": [{"type": "forecast_tomorrow", "op": "lte", "thresholdKwh": 5}], "customActions": [{"type": "grid_charge_toggle", "enabled": true}]}}},
    {"name": "custom: day-ahead price", "needsCloud": true,
     "event": {"mode": "custom", "config": {"customConditions": [{"type": "dam_price", "op": "gte", "thresholdUahKwh": 6.5}], "customActions": [{"type": "work_mode", "value": 0}]}}},
    {"name": "custom: scheduled outage", "needsCloud": true,
     "event": {"mode": "custom", "config": {"customConditions": [{"type": "scheduled_outage", "inWindow": true}], "customActions": [{"type": "grid_charge_toggle", "enabled": true}]}}},
    {"name": "rule: battery level and a cloud condition", "needsCloud": true,
     "event": {"mode": "custom", "schedule": {"recurrence": "always"}, "config": {"customConditions": [{"type": "battery_soc", "op": "lte", "threshold": 30}, {"type": "forecast_today", "op": "lte", "thresholdKwh": 10}], "customActions": [{"type": "grid_charge_toggle", "enabled": true}]}}},
    {"name": "rule: battery level only", "needsCloud": false,
     "event": {"mode": "custom", "schedule": {"recurrence": "always"}, "config": {"customConditions": [{"type": "battery_soc", "op": "lte", "threshold": 30, "releaseThreshold": 40}], "customActions": [{"type": "grid_charge_toggle", "enabled": true}]}}},
    {"name": "custom: grid and power conditions", "needsCloud": false,
     "event": {"mode": "custom", "config": {"customConditions": [{"type": "grid", "state": "down"}, {"type": "pv_power", "op": "gte", "thresholdW": 3000}, {"type": "load_power", "op": "lte", "thresholdW": 500}], "customActions": [{"type": "work_mode", "value": 2}]}}},
    {"name": "sell to grid gated on the forecast", "needsCloud": true,
     "event": {"mode": "sell_to_grid", "config": {"sellMode": "simple", "minForecastKwh": 20}}},
    {"name": "sell to grid with a zero forecast threshold", "needsCloud": true,
     "event": {"mode": "sell_to_grid", "config": {"sellMode": "simple", "minForecastKwh": 0}}},
    {"name": "sell to grid with a minimum price", "needsCloud": true,
     "event": {"mode": "sell_to_grid", "config": {"sellMode": "simple", "damPriceMinUahKwh": 5}}},
    {"name": "battery charge with a maximum price", "needsCloud": true,
     "event": {"mode": "battery_charge", "config": {"chargeSource": "grid", "targetSoc": 90, "damPriceMaxUahKwh": 3.2}}},
    {"name": "battery charge skipped on a good forecast", "needsCloud": true,
     "event": {"mode": "battery_charge", "config": {"chargeSource": "grid", "targetSoc": 90, "forecastThresholdKwh": 15}}},
    {"name": "sell to grid with no threshold", "needsCloud": false,
     "event": {"mode": "sell_to_grid", "config": {"sellMode": "simple", "minSocPercent": 30}}},
    {"name": "smart sell gated on PV only", "needsCloud": false,
     "event": {"mode": "sell_to_grid", "config": {"sellMode": "smart", "pvThresholdW": 500}}},
    {"name": "sell to grid with null thresholds", "needsCloud": false,
     "event": {"mode": "sell_to_grid", "config": {"sellMode": "simple", "minForecastKwh": null, "damPriceMinUahKwh": null, "damPriceMaxUahKwh": null}}},
    {"name": "battery charge with no threshold", "needsCloud": false,
     "event": {"mode": "battery_charge", "config": {"chargeSource": "grid", "targetSoc": 100}}},
    {"name": "use battery", "needsCloud": false,
     "event": {"mode": "use_battery", "config": {}}},
    {"name": "battery maintenance", "needsCloud": false,
     "event": {"mode": "battery_maintenance", "config": {"gridFallbackHour": 6}}},
    {"name": "lower consumption that waits for a scheduled outage", "needsCloud": true,
     "event": {"mode": "lower_consumption", "config": {"requireScheduledOutage": true}}}
  ]
}
