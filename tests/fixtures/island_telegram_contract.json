{
  "description": "The island Telegram LAN contract, written from the ROUTES as implemented (add-on telegram/views.py and the phone station's PhoneTelegramStation.handle), not from the app client. The app client and both stations are held to it. Change all three together.",
  "token": "123456:AAbbCCddEEffGGhhIIjjKKllMMnnOOpp_x",
  "botUsername": "my_bot",
  "linkedChat": { "chatId": 77, "username": "ann", "language": "uk" },
  "stationKinds": {
    "ha": "Home Assistant add-on. The two bot routes are signed (signedSend): the body is {signingKeyId, signedData, signature} and signedData holds the request's fields plus a nonce and ts in epoch milliseconds. Every other route is keyed (keyedSend).",
    "phone": "Phone station. Every route is keyed (keyedSend), the bot routes included: the body is the flat fields, here {token}. No keypair is needed."
  },
  "setups": {
    "no_bot": "The station holds no bot token. The calling phone is unlinked.",
    "bot": "The station holds the token and the username in botUsername. The calling phone is unlinked.",
    "linked": "As bot, and the calling phone is linked to linkedChat, enabled."
  },
  "sendsNote": "A case's sends is false unless the case says otherwise. HA: no config entry with the cloud copy off. Phone: no household with the cloud copy off. sends true: one entry or household has it off.",
  "telegramScripts": {
    "ok": "getMe answers {ok, result: {username: botUsername}}, getWebhookInfo answers an empty url, sendMessage answers 200.",
    "getMe_401": "getMe answers HTTP 401.",
    "getMe_down": "getMe fails at the transport.",
    "webhook": "getWebhookInfo answers a non-empty url.",
    "send_403": "sendMessage answers HTTP 403 (the user blocked the bot).",
    "send_401": "sendMessage answers HTTP 401.",
    "send_down": "sendMessage fails at the transport."
  },
  "matchers": "A case's reply.volatile names body fields compared by pattern instead of equality. A value starting with 'iso8601' means any ISO-8601 timestamp; any other value is a regular expression the whole string must match.",
  "layers": "reply.layer 'server' marks a refusal the station's HTTP layer gives before any route runs (HA: the view's island-key check, phone: PhoneStationServer). The phone station's handle() is never reached, so island_telegram_test.dart skips it and phone_station_server_test.dart owns it.",
  "routes": [
    { "id": "get_status", "method": "GET", "path": "/api/svitgrid/telegram", "auth": { "ha": "keyed", "phone": "keyed" } },
    { "id": "put_bot", "method": "PUT", "path": "/api/svitgrid/telegram/bot", "auth": { "ha": "signed:telegram_set_bot", "phone": "keyed" } },
    { "id": "delete_bot", "method": "DELETE", "path": "/api/svitgrid/telegram/bot", "auth": { "ha": "signed:telegram_remove_bot", "phone": "keyed" } },
    { "id": "post_link", "method": "POST", "path": "/api/svitgrid/telegram/link", "auth": { "ha": "keyed", "phone": "keyed" } },
    { "id": "patch_me", "method": "PATCH", "path": "/api/svitgrid/telegram/me", "auth": { "ha": "keyed", "phone": "keyed" } },
    { "id": "delete_me", "method": "DELETE", "path": "/api/svitgrid/telegram/me", "auth": { "ha": "keyed", "phone": "keyed" } },
    { "id": "post_test", "method": "POST", "path": "/api/svitgrid/telegram/test", "auth": { "ha": "keyed", "phone": "keyed" } }
  ],
  "appErrors": [
    "invalidToken", "botHasWebhook", "telegramUnreachable", "notSigner",
    "noBot", "notLinked", "stationUnreachable", "failed"
  ],
  "errorCodes": [
    { "status": 400, "code": "invalid_token", "appError": "invalidToken" },
    { "status": 409, "code": "bot_has_webhook", "appError": "botHasWebhook" },
    { "status": 502, "code": "telegram_unreachable", "appError": "telegramUnreachable" },
    { "status": 403, "code": "signature_invalid", "appError": "notSigner" },
    { "status": null, "code": "no_signing_key", "appError": "notSigner", "note": "Raised by the app itself when this phone holds no keypair; no station says it." },
    { "status": 409, "code": "no_bot", "appError": "noBot" },
    { "status": 409, "code": "not_linked", "appError": "notLinked" },
    { "status": null, "code": "no_answer", "appError": "stationUnreachable", "note": "The station did not answer." },
    { "status": 400, "code": "bad_request", "appError": "failed" },
    { "status": 401, "code": "unauthorized", "appError": "failed" },
    { "status": 403, "code": "stale_request", "appError": "failed" },
    { "status": 403, "code": "replayed", "appError": "failed" },
    { "status": 405, "code": "method_not_allowed", "appError": "failed" },
    { "status": 500, "code": "boom", "appError": "failed" }
  ],
